# ----------------------------------------------------------------------------
# Runtime configuration for the AFFiNE remote MCP server.
# Set these as ENVIRONMENT VARIABLES in Coolify — do NOT commit real values.
# ----------------------------------------------------------------------------

# AFFiNE instance the MCP connects OUT to. Use AFFiNE Cloud or your self-hosted URL.
AFFINE_BASE_URL=https://app.affine.pro

# Access token generated in your AFFiNE account
# (Settings -> account -> API / access tokens). Starts with "ut_".
AFFINE_API_TOKEN=ut_xxxxxxxxxxxxxxxxxxxxxxxx

# Transport. Keep "http" for a remote server.
MCP_TRANSPORT=http

# --- Auth between the CLIENT (Claude) and THIS MCP server ---
# bearer : server requires  Authorization: Bearer <AFFINE_MCP_HTTP_TOKEN>
#          Works with Claude Code / Desktop. Claude WEB cannot send this header.
# none   : no transport auth — you MUST protect the public URL another way
#          (Cloudflare Access). This is the path for the claude.ai web connector.
AFFINE_MCP_AUTH_MODE=bearer

# Only used when AFFINE_MCP_AUTH_MODE=bearer. Generate a long random secret.
AFFINE_MCP_HTTP_TOKEN=change-me-to-a-long-random-secret
